OPENAI_API_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=      # server only: never put this in the UI container or the browser

# Optional
SUPABASE_ANON_KEY=              # enables the sign-in form in the UI (Supabase dashboard -> API keys -> anon / publishable)
AUTH_REQUIRED=false             # true for anything public: only a verified login can own documents
RERANK_ENABLED=false            # cross-encoder reranking (slower; see README Phase 2)
VECTOR_STORE=supabase           # or "local": no database needed, data in data/local_store.pkl
USDA_API_KEY=DEMO_KEY           # FoodData Central for the food lookup tool; free key at https://api.data.gov/signup
TOOLS_ENABLED=true              # calorie / recommended-intake / food tools
CACHE_ENABLED=true              # semantic answer cache
LOG_INTERACTIONS=true           # store questions + answers (+ thumbs up/down) for review; needs 003_interactions.sql
QUERY_DECOMPOSITION=false       # measured worse on the golden set (README, Phase 6)
CONTEXTUAL_EMBEDDINGS=false     # no measured gain; changing it requires re-adding documents
